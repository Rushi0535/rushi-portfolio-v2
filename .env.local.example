# Gmail SMTP credentials for the Contact Me form (app/api/contact/route.ts)
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Gmail address the contact form sends from
CONTACT_EMAIL_USER=your-gmail-address@gmail.com

# Gmail App Password (not your regular password) — generate one at
# https://myaccount.google.com/apppasswords
CONTACT_EMAIL_APP_PASSWORD=your-16-character-app-password

# Address that receives contact form submissions (can be the same as CONTACT_EMAIL_USER)
CONTACT_EMAIL_TO=your-gmail-address@gmail.com

# --- Rushi's AI chatbot (app/api/chat/route.ts, app/api/chat/clear/route.ts) ---

# Groq API key for chat completions — https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Google service account credentials as a single-line JSON string (not a file
# path) — create a service account in Google Cloud Console, generate a JSON
# key, share the target Google Sheet with the service account's email, then
# paste the entire JSON file's contents here as one line.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ID of the Google Sheet chat messages get logged to (the long id in the
# sheet's URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit)
GOOGLE_SHEET_ID=your-google-sheet-id
