# Gmail SMTP credentials for the Contact Me form (app/api/contact/route.ts)
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Gmail address the contact form sends from
CONTACT_EMAIL_USER=your-gmail-address@gmail.com

# Gmail App Password (not your regular password) — generate one at
# https://myaccount.google.com/apppasswords
CONTACT_EMAIL_APP_PASSWORD=your-16-character-app-password

# Address that receives contact form submissions (can be the same as CONTACT_EMAIL_USER)
CONTACT_EMAIL_TO=your-gmail-address@gmail.com
